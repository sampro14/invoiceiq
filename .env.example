# Copy to .env. Without GEMINI_API_KEY the app runs in offline mode: rule-based readers, digital PDFs only.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Models are config. Re-score with the eval harness before switching one on.
# PRIMARY_MODEL=gemini-3.5-flash-lite
# PRIMARY_THINKING_LEVEL=minimal     # not accepted by Gemini 3.8 Flash or Gemini 4
# SECOND_MODEL=openai/gpt-oss-120b
# SECOND_VISION_MODEL=qwen/qwen3.8-27b
# PRICE_OVERRIDES=my-model=0.10/0.40

# Handy while developing
# RUNS_PER_IP_PER_HOUR=1000
# RUNS_PER_DAY=1000
